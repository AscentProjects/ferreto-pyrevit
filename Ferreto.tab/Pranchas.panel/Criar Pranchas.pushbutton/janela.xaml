<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Criar pranchas em lote" Width="560" Height="520"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        FontFamily="Segoe UI" FontSize="13">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Text="Família de prancha (padrão)" Margin="0,0,0,6"/>
    <ComboBox Grid.Row="1" x:Name="cb_familia" Height="28" Margin="0,0,0,14"/>
    <TextBlock Grid.Row="2" Margin="0,0,0,6" TextWrapping="Wrap"
               Text="Uma prancha por linha: número | nome | família (opcional)"/>
    <TextBox Grid.Row="3" x:Name="tb_lista" AcceptsReturn="True" FontFamily="Consolas"
             VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"
             Text="HID-01 | PLANTA HIDRÁULICA - TÉRREO&#10;HID-02 | PLANTA SANITÁRIA - TÉRREO&#10;HID-03 | ISOMÉTRICOS ÁGUA FRIA&#10;HID-04 | DETALHES"/>
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="Importar do Excel" Width="140" Height="30" Margin="0,0,8,0" Click="importar_excel"/>
      <Button Content="Cancelar" Width="90" Height="30" Margin="0,0,8,0" Click="cancelar"/>
      <Button Content="Criar pranchas" Width="120" Height="30" IsDefault="True" Click="criar"/>
    </StackPanel>
  </Grid>
</Window>
