<?xml version="1.0" encoding="utf-8"?>
<!-- Janela do botão "Criar Pranchas" (carregada por pyrevit.forms.WPFWindow).
     Os eventos dos botões são ligados no script.py, não aqui. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Criar pranchas em lote"
        Width="720" Height="540"
        MinWidth="520" MinHeight="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- rótulo do carimbo -->
            <RowDefinition Height="Auto"/>  <!-- menu de carimbos -->
            <RowDefinition Height="Auto"/>  <!-- instruções da lista -->
            <RowDefinition Height="*"/>     <!-- caixa de texto -->
            <RowDefinition Height="Auto"/>  <!-- mensagem de status -->
            <RowDefinition Height="Auto"/>  <!-- botões -->
        </Grid.RowDefinitions>

        <!-- 1. Carimbo padrão -->
        <TextBlock Grid.Row="0" Text="Carimbo padrão" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <ComboBox Grid.Row="1" x:Name="cb_carimbo" Height="26" Margin="0,0,0,12"
                  VerticalContentAlignment="Center"/>

        <!-- 2. Lista de pranchas -->
        <StackPanel Grid.Row="2" Margin="0,0,0,4">
            <TextBlock Text="Pranchas (uma por linha)" FontWeight="SemiBold"/>
            <TextBlock Foreground="#666666" TextWrapping="Wrap" Margin="0,2,0,0"
                       Text="número | nome | carimbo (opcional)     Ex.: A-101 | Planta Baixa Térreo | A1 : Padrão"/>
        </StackPanel>
        <TextBox Grid.Row="3" x:Name="tb_lista"
                 AcceptsReturn="True" AcceptsTab="False"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="13"
                 Padding="4"/>

        <!-- Status (ex.: quantas linhas vieram do Excel) -->
        <TextBlock Grid.Row="4" x:Name="tx_status" Foreground="#2E6B30"
                   TextWrapping="Wrap" Margin="0,6,0,0"/>

        <!-- 3 e 4. Botões -->
        <DockPanel Grid.Row="5" Margin="0,12,0,0" LastChildFill="False">
            <Button x:Name="bt_importar" DockPanel.Dock="Left"
                    Content="Importar do Excel" Padding="14,4" MinWidth="130"/>
            <Button x:Name="bt_cancelar" DockPanel.Dock="Right"
                    Content="Cancelar" Padding="14,4" MinWidth="90" Margin="8,0,0,0"/>
            <Button x:Name="bt_criar" DockPanel.Dock="Right"
                    Content="Criar pranchas" Padding="14,4" MinWidth="120"
                    FontWeight="SemiBold"/>
        </DockPanel>
    </Grid>
</Window>
